std::wstring
utf8_to_wide(const std::string& value) {
    if (value.empty())
        return {};
    const int count = MultiByteToWideChar(
        CP_UTF8, MB_ERR_INVALID_CHARS, value.data(), static_cast<int>(value.size()), nullptr, 0);
    if (count <= 0)
        return L"[invalid UTF-8 transcript]";
    std::wstring out(static_cast<size_t>(count), L'\0');
    MultiByteToWideChar(
        CP_UTF8, MB_ERR_INVALID_CHARS, value.data(), static_cast<int>(value.size()), out.data(),
        count);
    return out;
}

std::string
wide_to_utf8(const std::wstring& value) {
    if (value.empty())
        return {};
    const int count = WideCharToMultiByte(
        CP_UTF8, WC_ERR_INVALID_CHARS, value.data(), static_cast<int>(value.size()), nullptr, 0,
        nullptr, nullptr);
    if (count <= 0)
        return {};
    std::string out(static_cast<size_t>(count), '\0');
    WideCharToMultiByte(
        CP_UTF8, WC_ERR_INVALID_CHARS, value.data(), static_cast<int>(value.size()), out.data(),
        count, nullptr, nullptr);
    return out;
}

std::wstring
format_hresult(const wchar_t* operation, HRESULT hr) {
    wchar_t code[24] = {};
    swprintf_s(code, L"0x%08lX", static_cast<unsigned long>(hr));
    return std::wstring(operation) + L" failed (" + code + L")";
}

std::wstring
asr_error(const wchar_t* operation) {
    const char* detail = nemo_speech_asr_last_error();
    return std::wstring(operation) + L": " + utf8_to_wide(detail ? detail : "unknown ASR error");
}

std::wstring
trim_and_flatten(std::wstring text) {
    for (wchar_t& c : text) {
        if (c == L'\r' || c == L'\n' || c == L'\t')
            c = L' ';
    }
    const auto non_space = [](wchar_t c) { return c != L' '; };
    const auto first = std::find_if(text.begin(), text.end(), non_space);
    const auto last = std::find_if(text.rbegin(), text.rend(), non_space).base();
    if (first >= last)
        return {};
    text = std::wstring(first, last);
    std::wstring compact;
    compact.reserve(text.size());
    bool previous_space = false;
    for (wchar_t c : text) {
        const bool space = c == L' ';
        if (!space || !previous_space)
            compact.push_back(c);
        previous_space = space;
    }
    return compact;
}

std::filesystem::path executable_directory();

std::filesystem::path
new_debug_wav_path(const std::filesystem::path& directory) {
    SYSTEMTIME now = {};
    GetLocalTime(&now);
    wchar_t stem[80] = {};
    swprintf_s(
        stem, L"dictation_%04u%02u%02u_%02u%02u%02u_%03u", now.wYear, now.wMonth,
        now.wDay, now.wHour, now.wMinute, now.wSecond, now.wMilliseconds);
    std::filesystem::path candidate = directory / (std::wstring(stem) + L".wav");
    for (unsigned suffix = 1; std::filesystem::exists(candidate); ++suffix)
        candidate = directory / (std::wstring(stem) + L"_" + std::to_wstring(suffix) + L".wav");
    return candidate;
}

bool
write_pcm16_wav(
    const std::filesystem::path& path, const std::vector<float>& samples, int sample_rate,
    std::wstring& error) {
    constexpr uint64_t kHeaderOverhead = 36;
    const uint64_t data_size_64 = samples.size() * sizeof(int16_t);
    if (sample_rate <= 0 || data_size_64 > std::numeric_limits<uint32_t>::max() - kHeaderOverhead) {
        error = L"Debug recording is too large for a standard WAV file";
        return false;
    }
    const uint32_t data_size = static_cast<uint32_t>(data_size_64);
    const uint32_t riff_size = static_cast<uint32_t>(kHeaderOverhead + data_size);
    const uint16_t pcm = 1;
    const uint16_t channels = 1;
    const uint16_t bits = 16;
    const uint16_t block_align = channels * bits / 8;
    const uint32_t byte_rate = static_cast<uint32_t>(sample_rate) * block_align;
    const uint32_t rate = static_cast<uint32_t>(sample_rate);

    std::ofstream output(path, std::ios::binary | std::ios::trunc);
    if (!output) {
        error = L"Could not create debug WAV: " + path.wstring();
        return false;
    }
    output.write("RIFF", 4);
    output.write(reinterpret_cast<const char*>(&riff_size), sizeof(riff_size));
    output.write("WAVEfmt ", 8);
    const uint32_t fmt_size = 16;
    output.write(reinterpret_cast<const char*>(&fmt_size), sizeof(fmt_size));
    output.write(reinterpret_cast<const char*>(&pcm), sizeof(pcm));
    output.write(reinterpret_cast<const char*>(&channels), sizeof(channels));
    output.write(reinterpret_cast<const char*>(&rate), sizeof(rate));
    output.write(reinterpret_cast<const char*>(&byte_rate), sizeof(byte_rate));
    output.write(reinterpret_cast<const char*>(&block_align), sizeof(block_align));
    output.write(reinterpret_cast<const char*>(&bits), sizeof(bits));
    output.write("data", 4);
    output.write(reinterpret_cast<const char*>(&data_size), sizeof(data_size));
    std::vector<int16_t> pcm_buffer(4096);
    for (size_t offset = 0; offset < samples.size();) {
        const size_t count = std::min(pcm_buffer.size(), samples.size() - offset);
        for (size_t i = 0; i < count; ++i) {
            const float value = std::clamp(samples[offset + i], -1.0f, 1.0f);
            pcm_buffer[i] = static_cast<int16_t>(
                value <= -1.0f ? -32768 : std::lround(value * 32767.0f));
        }
        output.write(
            reinterpret_cast<const char*>(pcm_buffer.data()),
            static_cast<std::streamsize>(count * sizeof(int16_t)));
        offset += count;
    }
    if (!output) {
        error = L"Writing debug WAV failed: " + path.wstring();
        return false;
    }
    return true;
}

bool
write_utf8_text(const std::filesystem::path& path, const std::string& text, std::wstring& error) {
    std::ofstream output(path, std::ios::binary | std::ios::trunc);
    if (!output) {
        error = L"Could not create offline transcript: " + path.wstring();
        return false;
    }
    output.write(text.data(), static_cast<std::streamsize>(text.size()));
    if (text.empty() || text.back() != '\n')
        output.put('\n');
    if (!output) {
        error = L"Writing offline transcript failed: " + path.wstring();
        return false;
    }
    return true;
}

